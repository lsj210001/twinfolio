# OpenAI-compatible endpoint. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BOOK_TRANSLATE_MODEL=gpt-4o-mini
# Gemini 3.7 不要用 minimal。也认旧名 BBM_REASONING_EFFORT
BOOK_TRANSLATE_REASONING_EFFORT=low
SHORT_BATCH_SIZE=8
# 按估算 token 攒批（短文件默认 600）
BOOK_TRANSLATE_BATCH_TOKENS=1600
# 按文件翻译并发（默认 1=串行，建议 2–4，上限 4）
BOOK_TRANSLATE_RESUME_WORKERS=1
# 滚动上下文（默认关）
BOOK_TRANSLATE_USE_CONTEXT=
